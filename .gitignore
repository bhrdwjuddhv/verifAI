# training artifacts & datasets
# Exclude the CONTENTS, not the directory — git cannot re-include a file whose parent dir is
# excluded, so every level needs its own /dir/* line before the ! entries.
#
# What ships: the files the SERVICE LOADS. A deploy has no way to fetch them — the Docker build
# can rebuild NPR and YuNet from public sources, but nothing can reconstruct a model you
# trained, and without it the service silently falls back to the third-party model or reports
# "not available". ~35MB total, all well under GitHub's per-file limit.
#
# What does NOT ship: every .pth. Those are training artifacts, only needed to re-export, and
# they double the weight for no runtime benefit.
/models/*
!/models/face/
/models/face/*
!/models/face/detector_v2.onnx
!/models/face/detector_v2.json
!/models/audio/
/models/audio/*
!/models/audio/audio_detector.onnx
!/models/audio/audio_detector.json
!/models/images/
/models/images/*
!/models/images/npr_detector.onnx
!/models/images/npr_detector.json
!/models/npr_detector.onnx
!/models/npr_detector.json
!/models/face_detection_yunet.onnx
/public/models/
/runs/

# data/ holds two different things: seed JSON that the eval routes import at BUILD time
# (must be committed, or Vercel fails with "Can't resolve @/data/..."), and runtime state
# with password hashes and sessions (must never be). Exclude the contents, re-include the
# three seed files by name — a negation cannot rescue a file whose parent dir is excluded.
/data/*
!/data/fusion-weights.json
!/data/judged-results.json
!/data/weight-history.json
*.pt
# binaries
ngrok.exe
ngrok.zip
.ngrok.exe.old

flow.md
youhavetodo.md
.github 

# browser extension — its own toolchain, built separately from the Next app.
# node_modules above is root-anchored, so the extension's copy needs its own line.
# Model binaries and the ORT wasm are COPIED IN at build time (from /models and
# node_modules); committing them would double the repo and bloat every Vercel deploy.
/extension/node_modules
/extension/dist
/extension/public/models
/extension/public/ort
/extension/*.zip
# Parity fixtures: large, and mostly not ours to redistribute. The README stays.
/extension/fixtures/*
!/extension/fixtures/README.md
